rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Acesso: contas Google listadas em allowedUsers/{email em minúsculas}.
    function signedEmail() {
      return request.auth.token.email.lower();
    }
    function member() {
      return /databases/$(database)/documents/allowedUsers/$(signedEmail());
    }
    function isTeam() {
      return request.auth != null && request.auth.token.email_verified == true && exists(member());
    }
    function isAdmin() {
      return isTeam() && get(member()).data.admin == true;
    }
    function validAudit(data) {
      return data.person is string && data.person.size() > 0
        && data.userEmail == signedEmail()
        && data.quantity is int && data.quantity > 0
        && data.materialId is string;
    }

    match /allowedUsers/{email} {
      // Cada pessoa pode confirmar o seu próprio acesso; a equipa vê a lista; só admins a alteram.
      allow get: if request.auth != null && email == signedEmail();
      allow list: if isTeam();
      allow create, update: if isAdmin() && email == email.lower()
        && request.resource.data.admin is bool && request.resource.data.name is string;
      allow delete: if isAdmin() && email != signedEmail();
    }
    match /materials/{id} {
      allow read: if isTeam();
      allow create: if isTeam() && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.active == true;
      allow update: if isTeam() && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow delete: if false;
    }
    match /boxes/{id} {
      allow read: if isTeam();
      allow create: if isTeam() && request.resource.data.name is string
        && request.resource.data.code is string && request.resource.data.name.size() > 0
        && request.resource.data.code.size() > 0 && request.resource.data.active == true;
      allow update: if isTeam() && request.resource.data.name is string
        && request.resource.data.code is string;
      allow delete: if false;
    }
    match /stocks/{id} {
      allow read: if isTeam();
      allow create: if isTeam() && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.materialId is string
        && request.resource.data.boxId is string
        && request.resource.data.lastOperationId is string
        && getAfter(/databases/$(database)/documents/movements/$(request.resource.data.lastOperationId)).data.materialId == request.resource.data.materialId;
      allow update: if isTeam()
        && request.resource.data.materialId == resource.data.materialId
        && request.resource.data.boxId == resource.data.boxId
        && request.resource.data.quantity is int && request.resource.data.quantity >= 0
        && request.resource.data.lastOperationId != resource.data.lastOperationId
        && getAfter(/databases/$(database)/documents/movements/$(request.resource.data.lastOperationId)).data.materialId == request.resource.data.materialId;
      allow delete: if false;
    }
    match /checkouts/{id} {
      allow read: if isTeam();
      allow create: if isTeam() && request.resource.data.initialQuantity is int
        && request.resource.data.initialQuantity > 0
        && request.resource.data.pendingQuantity == request.resource.data.initialQuantity
        && request.resource.data.status == "open"
        && request.resource.data.person is string && request.resource.data.person.size() > 0
        && request.resource.data.userEmail == signedEmail();
      allow update: if isTeam()
        && request.resource.data.materialId == resource.data.materialId
        && request.resource.data.userEmail == resource.data.userEmail
        && request.resource.data.initialQuantity == resource.data.initialQuantity
        && request.resource.data.pendingQuantity is int
        && request.resource.data.pendingQuantity >= 0
        && request.resource.data.pendingQuantity <= resource.data.pendingQuantity
        && ((request.resource.data.pendingQuantity == 0 && request.resource.data.status == "closed")
          || (request.resource.data.pendingQuantity > 0 && request.resource.data.status == "open"));
      allow delete: if false;
    }
    match /movements/{id} {
      allow read: if isTeam();
      allow create: if isTeam() && validAudit(request.resource.data)
        && request.resource.data.type in ["stock_in", "checkout", "return", "transfer", "write_off_stock", "write_off_checkout", "correction"];
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
